<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>YASSEN</title>
<meta name="description" content="YASSEN (Yassen Salah) — كل حساباتي وأغانيّ في مكان واحد: Kick وYouTube وTikTok وInstagram وSnapchat وSpotify وFacebook وDiscord وواتساب.">
<meta name="theme-color" content="#070b13">
<meta property="og:title" content="YASSEN">
<meta property="og:description" content="كل حسابات YASSEN في مكان واحد.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Cairo:wght@400;600;700;900&family=Space+Grotesk:wght@500;700&display=swap">
<style>
:root{
  --bg:#070b13; --bg2:#101a2e; --ink:#eef3fe; --muted:#9aa9c4;
  --v:#5b8def; --v2:#9cc2ff; --g:#7ee0c3; --g2:#5cc9a7;
  --glass:rgba(255,255,255,.05); --glass2:rgba(255,255,255,.09); --line:rgba(156,194,255,.2);
  --f-disp:'Anton','Cairo',Impact,sans-serif; --f-body:'Cairo','Space Grotesk',system-ui,sans-serif;
  --r:20px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:17px;line-height:1.7;overflow-x:hidden;-webkit-tap-highlight-color:transparent}
h1,h2,h3,p{margin:0}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;cursor:pointer;background:none;border:0}
:focus-visible{outline:3px solid var(--g);outline-offset:3px;border-radius:10px}
.ic{width:1.3em;height:1.3em;fill:currentColor;flex:none}
.ic.st{fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.wrap{width:100%;max-width:1180px;margin-inline:auto;padding-inline:clamp(16px,4vw,32px)}
section{padding-block:clamp(56px,9vw,104px);position:relative}
.d{font-family:var(--f-disp);letter-spacing:.02em;font-weight:400}

#bg{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
.aurora{position:fixed;inset:0;z-index:0;pointer-events:none;background:
  radial-gradient(900px 520px at 85% -8%,rgba(91,141,239,.28),transparent 70%),
  radial-gradient(700px 480px at 0% 55%,rgba(126,224,195,.09),transparent 70%),
  radial-gradient(800px 500px at 60% 110%,rgba(91,141,239,.2),transparent 70%)}
.glow{position:fixed;width:520px;height:520px;border-radius:50%;pointer-events:none;z-index:0;left:0;top:0;
  background:radial-gradient(circle,rgba(91,141,239,.16),transparent 65%);transform:translate(-50%,-50%);transition:opacity .3s;opacity:0}
main,header.nav,footer{position:relative;z-index:1}
.prog{position:fixed;top:0;inset-inline:0;height:3px;z-index:150;transform-origin:0 50%;transform:scaleX(0);background:linear-gradient(90deg,var(--v),var(--g))}
[dir=rtl] .prog{transform-origin:100% 50%}

/* welcome */
.welcome{position:fixed;inset:0;z-index:200;display:grid;place-items:center;padding:24px;background:radial-gradient(900px 600px at 50% 30%,#14305a,transparent 70%),#050810;
  transition:opacity .6s ease,transform .9s cubic-bezier(.7,0,.2,1),visibility 0s linear .9s}
.welcome.out{opacity:0;transform:scale(1.08);visibility:hidden;pointer-events:none}
.welcome canvas{position:absolute;inset:0;width:100%;height:100%}
.w-card{position:relative;text-align:center;display:grid;gap:16px;justify-items:center}
.w-logo{width:min(56vw,250px);aspect-ratio:1;border-radius:50%;object-fit:cover;box-shadow:0 0 0 3px rgba(156,194,255,.5),0 0 80px rgba(91,141,239,.7);animation:floaty 3.4s ease-in-out infinite}
.w-title{font-size:clamp(46px,12vw,92px);line-height:1;background:linear-gradient(180deg,#fff,#cfe0ff 60%,#5b8def);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:none;filter:drop-shadow(0 6px 30px rgba(91,141,239,.6))}
.w-sub{min-height:1.7em;color:var(--muted);font-weight:600}
.w-sub::after{content:"";display:inline-block;width:2px;height:1em;background:var(--g);margin-inline-start:4px;vertical-align:-2px;animation:blink 1s steps(1) infinite}
.w-bar{width:min(70vw,260px);height:4px;border-radius:4px;background:rgba(255,255,255,.12);overflow:hidden}
.w-bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--v),var(--g));animation:fill 4.2s linear forwards}
.w-btn{height:52px;padding:0 38px;border-radius:14px;background:var(--g);color:#06231c;font-weight:900;font-size:18px;box-shadow:0 10px 40px -8px rgba(126,224,195,.6);transition:transform .15s}
.w-btn:hover{transform:translateY(-2px) scale(1.03)}
.w-skip{font-size:13px;color:var(--muted)}
@keyframes fill{to{width:100%}}
@keyframes blink{50%{opacity:0}}
@keyframes floaty{50%{transform:translateY(-10px)}}

/* nav */
.nav{position:sticky;top:0;z-index:100;transition:background .3s,border-color .3s;border-bottom:1px solid transparent}
.nav.scrolled{background:rgba(7,11,19,.78);backdrop-filter:blur(16px);border-color:var(--line)}
.nav-in{display:flex;align-items:center;gap:18px;height:68px}
.brand{display:flex;align-items:center;gap:10px;font-size:24px;line-height:1}
.brand img{width:38px;height:38px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 2px var(--v)}
.nav-links{display:none;gap:4px;margin-inline:auto}
.nav-links a{padding:8px 14px;border-radius:10px;color:var(--muted);font-weight:600;font-size:15px;transition:color .15s,background .15s}
.nav-links a:hover,.nav-links a.on{color:var(--ink);background:var(--glass2)}
.tools{display:flex;gap:8px;margin-inline-start:auto}
.tbtn{height:40px;min-width:40px;padding:0 12px;border-radius:12px;border:1px solid var(--line);background:var(--glass);display:grid;place-items:center;font-size:14px;font-weight:700;transition:border-color .15s,background .15s}
.tbtn:hover{border-color:var(--v2);background:var(--glass2)}
.cmdbtn{display:none;font-family:'Space Grotesk',monospace;color:var(--muted)}
@media(min-width:960px){.nav-links{display:flex}.tools{margin-inline-start:0}.cmdbtn{display:grid}#menuBtn{display:none}}
.mnav{display:none;position:absolute;top:68px;inset-inline:0;background:rgba(7,11,19,.96);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);padding:12px 16px 20px;flex-direction:column;gap:2px}
.mnav.open{display:flex}
.mnav a{padding:12px 14px;border-radius:12px;font-weight:700}
.mnav a:hover{background:var(--glass2)}

/* buttons */
.btn{position:relative;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;gap:10px;height:52px;padding:0 26px;border-radius:14px;font-weight:900;font-size:16px;
  background:var(--g);color:#06231c;box-shadow:0 12px 36px -10px rgba(126,224,195,.55);transition:transform .15s,box-shadow .2s}
.btn:hover{transform:translateY(-2px);box-shadow:0 16px 44px -8px rgba(126,224,195,.7)}
.btn:active{transform:scale(.96)}
.btn.ghost{background:var(--glass);color:var(--ink);border:1px solid var(--line);box-shadow:none}
.btn.ghost:hover{border-color:var(--v2);background:var(--glass2)}
.btn.sm{height:42px;padding:0 18px;font-size:14px}
.ripple{position:absolute;border-radius:50%;pointer-events:none;background:rgba(255,255,255,.4);transform:scale(0);animation:rip .65s ease-out forwards}
@keyframes rip{to{transform:scale(1);opacity:0}}

/* hero */
.hero{padding-top:clamp(36px,6vw,80px);padding-bottom:clamp(48px,7vw,90px)}
.hero-grid{display:grid;gap:44px;align-items:center}
.hero-grid>*{min-width:0}
@media(min-width:900px){.hero-grid{grid-template-columns:1.1fr .9fr}}
.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:99px;border:1px solid var(--line);background:var(--glass);font-size:13px;font-weight:700;color:var(--v2);letter-spacing:.06em}

.name{font-family:var(--f-disp);font-weight:400;font-size:clamp(56px,14vw,124px);line-height:.9;margin-top:16px;letter-spacing:.01em;position:relative;display:inline-block;
  background:linear-gradient(180deg,#fff 10%,#dce8ff 45%,#6f9cf0 100%);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 8px 24px rgba(91,141,239,.3))}
.name::before,.name::after{content:attr(data-t);position:absolute;inset:0;background:inherit;-webkit-background-clip:text;background-clip:text;opacity:0}
.name:hover::before{opacity:.9;animation:gl1 .35s steps(2) infinite;-webkit-text-fill-color:var(--g);background:none;color:var(--g);clip-path:inset(0 0 55% 0)}
.name:hover::after{opacity:.9;animation:gl2 .35s steps(2) infinite;-webkit-text-fill-color:#8fd3ff;background:none;color:#8fd3ff;clip-path:inset(55% 0 0 0)}
@keyframes gl1{50%{transform:translate(-4px,1px)}}
@keyframes gl2{50%{transform:translate(4px,-1px)}}
.alias{margin-top:6px;display:flex;align-items:center;gap:10px;font-weight:700;color:var(--muted);font-size:18px}
.alias b{color:var(--g);font-family:var(--f-disp);font-weight:400;font-size:26px;letter-spacing:.06em}
.lead{margin-top:18px;color:#c3cfe6;font-size:clamp(17px,2.2vw,20px);max-width:34em}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.mini{display:flex;gap:10px;margin-top:26px;flex-wrap:wrap}
.mini a{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;border:1px solid var(--line);background:var(--glass);transition:transform .2s,background .2s,border-color .2s,color .2s}
.mini a:hover{transform:translateY(-4px);background:var(--bc,var(--v));border-color:transparent;color:#fff}
.stage{position:relative;display:grid;place-items:center;padding:34px;overflow:hidden;border-radius:40px}
.ring{position:relative;width:100%;max-width:min(78vw,430px);aspect-ratio:1;border-radius:50%;padding:5px;background:conic-gradient(from 0deg,var(--v),var(--g),#8fd3ff,var(--v));animation:spin 8s linear infinite;box-shadow:0 0 60px rgba(91,141,239,.35)}
.ring-in{width:100%;height:100%;border-radius:50%;overflow:hidden;background:#09111e;animation:spin 8s linear infinite reverse}
.ring-in img{width:100%;height:100%;object-fit:cover;display:block}
@keyframes spin{to{transform:rotate(360deg)}}

.fchip{position:absolute;display:flex;align-items:center;gap:8px;padding:9px 16px;border-radius:14px;background:rgba(10,6,22,.85);backdrop-filter:blur(10px);border:1px solid var(--line);font-weight:800;font-size:14px;animation:floaty 4s ease-in-out infinite}
.fchip.a{top:6%;inset-inline-start:0}
.fchip.b{bottom:8%;inset-inline-end:0;animation-delay:1.4s}
.fchip .ic{color:var(--g)}
.fchip .eq{display:flex;gap:2px;align-items:flex-end;height:14px}
.fchip .eq i{width:3px;background:var(--g);border-radius:2px;animation:eq 1s ease-in-out infinite}
.fchip .eq i:nth-child(2){animation-delay:.2s}.fchip .eq i:nth-child(3){animation-delay:.4s}
@keyframes eq{0%,100%{height:4px}50%{height:14px}}

:lang(ar) .head h2,:lang(ar) .cele h2,:lang(ar) .about h2,:lang(ar) .join h2{font-family:'Cairo',sans-serif;font-weight:900}
/* stats */
.stats{padding-block:0;margin-top:-10px}
.stats-in{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:var(--r);background:var(--glass);backdrop-filter:blur(10px);overflow:hidden}
.stat{padding:24px 12px;text-align:center;border-inline-end:1px solid var(--line)}
.stat:last-child{border:0}
.stat b{display:block;direction:ltr;font-family:var(--f-disp);font-weight:400;font-size:clamp(34px,7vw,64px);line-height:1;color:var(--g);text-shadow:0 0 30px rgba(126,224,195,.4)}
.stat span{font-size:clamp(12px,2.4vw,15px);color:var(--muted);font-weight:700}

/* heads */
.head{text-align:center;margin-bottom:44px}
.tag{display:inline-block;font-size:13px;font-weight:800;color:var(--g);letter-spacing:.14em;margin-bottom:8px}
.head h2{font-family:var(--f-disp);font-weight:400;font-size:clamp(40px,7vw,72px);line-height:1}
.head p{margin-top:12px;color:var(--muted);max-width:36em;margin-inline:auto}
.bar{display:block;width:70px;height:4px;border-radius:4px;margin:14px auto 0;background:linear-gradient(90deg,var(--v),var(--g))}

/* cards */
.cards{display:grid;gap:16px}
@media(min-width:640px){.cards{grid-template-columns:repeat(2,1fr)}}
@media(min-width:980px){.cards{grid-template-columns:repeat(3,1fr)}}
.card{--bc:var(--v);position:relative;overflow:hidden;display:flex;flex-direction:column;gap:8px;padding:26px;border-radius:var(--r);border:1px solid var(--line);background:var(--glass);transition:transform .25s,border-color .25s;transform-style:preserve-3d}
.card::before{content:"";position:absolute;inset:0;background:radial-gradient(320px circle at var(--mx,50%) var(--my,0%),color-mix(in srgb,var(--bc) 38%,transparent),transparent 65%);opacity:0;transition:opacity .25s}
.card:hover{border-color:var(--bc)}
.card:hover::before{opacity:1}
.card>*{position:relative}
.card .ico{width:56px;height:56px;border-radius:16px;display:grid;place-items:center;background:var(--bc);color:#fff;font-size:22px;box-shadow:0 12px 30px -10px var(--bc)}
.card h3{font-size:22px;margin-top:10px;font-weight:900}
.card p{color:var(--muted);font-size:15px}
.card .handle{font-family:'Space Grotesk',monospace;font-size:13px;color:var(--v2);direction:ltr;text-align:start;unicode-bidi:plaintext}
.go{margin-top:auto;padding-top:12px;display:flex;align-items:center;justify-content:space-between;font-weight:800;font-size:14px}
.go .arr{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--line);transition:background .2s,transform .2s,color .2s}
[dir=rtl] .go .arr svg{transform:scaleX(-1)}
.card:hover .arr{background:var(--g);color:#06231c;transform:scale(1.1);border-color:transparent}
.c-kick{--bc:#7ee0c3}.c-kick .ico{color:#06231c}
.c-yt{--bc:#ff1f2d}.c-tik2{--bc:#ff3d8b}.c-tik2 .ico{color:#fff}.c-sc{--bc:#fffc00}.c-sc .ico{color:#111}.c-sp{--bc:#1db954}.c-sp .ico{color:#04150a}.c-fb{--bc:#1877f2}.c-dc{--bc:#5865f2}.c-tik{--bc:#00e5ff}.c-tik .ico{color:#05161a}.c-ig{--bc:#e1306c}.c-wa{--bc:#25d366}.c-wa .ico{color:#04150a}
.c-kick{grid-column:1/-1}
@media(min-width:640px){.c-kick{grid-column:span 2}}

/* celebration */
.cele{display:grid;gap:36px;align-items:center}
@media(min-width:900px){.cele{grid-template-columns:1.25fr 1fr}}
.shot{position:relative;border-radius:var(--r);overflow:hidden;border:1px solid var(--line);box-shadow:0 30px 80px -30px rgba(91,141,239,.7);cursor:zoom-in;display:block;width:100%;padding:0}
.shot img{display:block;width:100%;height:auto;transition:transform .6s}
.shot:hover img{transform:scale(1.04)}
.shot::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 40%,rgba(255,255,255,.18) 50%,transparent 60%);transform:translateX(-120%);transition:transform .9s}
.shot:hover::after{transform:translateX(120%)}
.cele h2{font-family:var(--f-disp);font-weight:400;font-size:clamp(38px,6vw,64px);line-height:1.05;margin:12px 0}
.cele h2 em{font-style:normal;color:var(--g)}
.cele p{color:#c3cfe6}

/* about */
.about{display:grid;gap:40px;align-items:center}
@media(min-width:900px){.about{grid-template-columns:.8fr 1.2fr}}
.about-art{display:grid;place-items:center}
.about-art img{width:min(72vw,360px);border-radius:28px;box-shadow:0 0 0 1px var(--line),0 30px 80px -30px rgba(91,141,239,.8);transform:rotate(-3deg);transition:transform .4s}
.about-art img:hover{transform:rotate(0) scale(1.03)}
.about h2{font-family:var(--f-disp);font-weight:400;font-size:clamp(38px,6vw,64px);line-height:1.05;margin:12px 0}
.about .txt{color:#c3cfe6}
.feats{display:grid;gap:12px;margin-top:26px}
@media(min-width:560px){.feats{grid-template-columns:repeat(2,1fr)}}
.feat{display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:16px;border:1px solid var(--line);background:var(--glass)}
.feat .ic{color:var(--g);font-size:22px}
.feat b{display:block;font-size:15px}.feat span{font-size:13px;color:var(--muted)}

/* qr */
.qr{display:grid;gap:30px;align-items:center;justify-items:center;padding:30px;border:1px solid var(--line);border-radius:var(--r);background:var(--glass)}
@media(min-width:820px){.qr{grid-template-columns:1fr 1fr;justify-items:stretch}}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chips button{padding:8px 16px;border-radius:99px;border:1px solid var(--line);background:var(--glass);font-weight:700;font-size:14px;transition:all .15s}
.chips button[aria-pressed=true]{background:var(--v);border-color:var(--v);color:#fff}
.qr-box{display:grid;gap:14px;justify-items:center}
.qr-card{padding:12px;border-radius:20px;background:#fff;box-shadow:0 0 60px rgba(91,141,239,.5)}
.qr-card canvas{width:min(62vw,230px);height:auto;display:block}
.qr-url{font-family:'Space Grotesk',monospace;font-size:12px;color:var(--muted);direction:ltr;word-break:break-all;text-align:center}
.qr-hint{color:var(--muted);margin-bottom:16px}

/* faq */
.faq{max-width:780px;margin-inline:auto;display:grid;gap:10px}
.qa{border:1px solid var(--line);border-radius:16px;background:var(--glass);overflow:hidden}
.qa summary{list-style:none;cursor:pointer;padding:18px 22px;font-weight:800;display:flex;justify-content:space-between;gap:12px;align-items:center}
.qa summary::-webkit-details-marker{display:none}
.qa summary::after{content:"+";font-size:24px;color:var(--g);transition:transform .25s;line-height:1}
.qa[open] summary::after{transform:rotate(45deg)}
.qa p{padding:0 22px 20px;color:#c3cfe6}

/* join */
.join{position:relative;overflow:hidden;text-align:center;padding:clamp(40px,7vw,80px) 24px;border-radius:28px;border:1px solid var(--line);
  background:radial-gradient(600px 300px at 50% 0%,rgba(91,141,239,.45),transparent 70%),linear-gradient(160deg,#112038,#09101c)}
.join h2{font-family:var(--f-disp);font-weight:400;font-size:clamp(40px,8vw,84px);line-height:1}
.join p{margin:14px auto 28px;color:#c3cfe6;max-width:30em}
.join .cta{justify-content:center;margin:0}

/* footer */
footer{padding:48px 0 110px;border-top:1px solid var(--line)}
.foot{display:grid;gap:22px;justify-items:center;text-align:center}
.foot-links{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
.foot-links a{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;border:1px solid var(--line);background:var(--glass);transition:all .2s}
.foot-links a:hover{background:var(--bc,var(--v));border-color:transparent;transform:translateY(-3px);color:#fff}
.copy{color:var(--muted);font-size:14px}
.made{font-size:13px;color:var(--muted);font-family:'Space Grotesk',monospace;letter-spacing:.08em}
.madeb{color:var(--g);font:inherit;letter-spacing:inherit;cursor:pointer;border-bottom:1px dashed var(--g);padding:0 2px}
.madeb:hover{color:#fff}

/* misc UI */
.toast{position:fixed;left:50%;bottom:90px;transform:translate(-50%,20px);background:var(--g);color:#06231c;padding:10px 20px;border-radius:12px;font-weight:800;font-size:14px;opacity:0;pointer-events:none;transition:all .25s;z-index:260}
.toast.on{opacity:1;transform:translate(-50%,0)}
.totop{position:fixed;bottom:22px;inset-inline-start:20px;width:46px;height:46px;border-radius:14px;background:var(--v);display:grid;place-items:center;z-index:90;opacity:0;pointer-events:none;transform:translateY(12px);transition:all .25s;box-shadow:0 10px 30px -8px var(--v)}
.totop.on{opacity:1;pointer-events:auto;transform:none}
.dock{position:fixed;bottom:18px;left:50%;transform:translate(-50%,120px);display:flex;gap:6px;padding:8px;border-radius:20px;background:rgba(10,16,30,.88);backdrop-filter:blur(14px);border:1px solid var(--line);z-index:90;transition:transform .35s;box-shadow:0 20px 50px -10px #000}
.dock.on{transform:translate(-50%,0)}
.dock a{width:44px;height:44px;border-radius:13px;display:grid;place-items:center;transition:all .18s}
.dock a:hover{background:var(--bc,var(--v));color:#fff;transform:translateY(-5px) scale(1.1)}
@media(max-width:560px){.dock a{width:40px;height:40px}.totop{bottom:76px}}
#cmd,#lb{position:fixed;inset:0;z-index:300;background:rgba(3,5,10,.75);backdrop-filter:blur(6px);display:none;padding:14vh 16px 16px;justify-content:center;align-items:flex-start}
#cmd.open,#lb.open{display:flex}
.cm{width:100%;max-width:540px;border:1px solid var(--line);border-radius:18px;background:#0c1424;overflow:hidden;box-shadow:0 40px 100px #000}
.cm input{width:100%;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);font:700 17px var(--f-body);padding:18px 20px;outline:none}
.cm ul{list-style:none;margin:0;padding:6px;max-height:340px;overflow:auto}
.cm li{display:flex;justify-content:space-between;gap:12px;padding:11px 14px;border-radius:11px;cursor:pointer;font-weight:700;font-size:15px}
.cm li small{color:var(--muted);font-family:'Space Grotesk',monospace;font-size:12px}
.cm li.sel{background:var(--glass2);color:var(--g)}
.cm-foot{padding:10px;text-align:center;font-size:12px;color:var(--muted);border-top:1px solid var(--line)}
#lb{align-items:center;padding:20px;cursor:zoom-out}
#lb img{max-width:min(96vw,1100px);max-height:86vh;border-radius:16px;box-shadow:0 30px 100px #000}


/* live status */
.lv{display:none;margin-top:18px;align-items:center;gap:12px;padding:10px 16px;border-radius:16px;border:1px solid var(--line);background:var(--glass);max-width:max-content;flex-wrap:wrap}
.lv.show{display:inline-flex}
.lv .dot{width:10px;height:10px;border-radius:50%;background:#737f90;flex:none}
.lv .st{font-weight:900;font-size:13px;letter-spacing:.1em}
.lv .tt{font-weight:700;font-size:15px;max-width:34ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lv .mt{color:var(--muted);font-size:13px;font-weight:700}
.lv.on{border-color:rgba(255,45,60,.6);background:rgba(255,45,60,.1);box-shadow:0 0 40px -8px rgba(255,45,60,.6);cursor:pointer}
.lv.on .dot{background:#ff2d3c;animation:pulse 1.2s ease-out infinite}
.lv.on .st{color:#ff4b58}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(255,45,60,.7)}100%{box-shadow:0 0 0 12px rgba(255,45,60,0)}}
.fchip.a.live{border-color:rgba(255,45,60,.7)}
.fchip.a.live .eq i{background:#ff2d3c}
.ndot{display:none;width:8px;height:8px;border-radius:50%;background:#ff2d3c;margin-inline-start:6px;animation:pulse 1.2s ease-out infinite}
body.islive .ndot{display:inline-block}
.livebox{margin-bottom:34px}
.player{position:relative;aspect-ratio:16/9;border-radius:var(--r);overflow:hidden;border:1px solid rgba(255,45,60,.5);background:#000;box-shadow:0 30px 80px -30px rgba(255,45,60,.5)}
.player iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.player button{position:absolute;inset:0;width:100%;display:grid;place-items:center;align-content:center;gap:14px;background:radial-gradient(500px 260px at 50% 40%,rgba(91,141,239,.5),#070b13);font-weight:900;font-size:20px}
.player button .pl{width:76px;height:76px;border-radius:50%;background:var(--g);color:#06231c;display:grid;place-items:center;box-shadow:0 0 50px rgba(126,224,195,.5)}
.player button .pl svg{width:34px;height:34px}
.livebox .cap{display:flex;gap:10px;align-items:center;margin-top:12px;font-weight:800;flex-wrap:wrap}
.livebox .cap span{color:var(--muted);font-weight:700;font-size:14px}

/* settings */
.noanim *,.noanim *::before,.noanim *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
.noanim .rv{opacity:1!important;transform:none!important}
.noanim .w-bar i{width:100%}
.noanim .welcome{display:none}
#set{position:absolute;top:62px;inset-inline-end:clamp(16px,4vw,32px);width:280px;border:1px solid var(--line);border-radius:16px;background:#0c1424;padding:14px;display:none;box-shadow:0 30px 80px #000;z-index:120}
#set.open{display:block}
#set h3{font-size:15px;margin:0 0 10px;font-weight:900}
.srow{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 4px;border-top:1px solid var(--line);font-weight:700;font-size:14px}
.srow:first-of-type{border-top:0}
.srow small{display:block;color:var(--muted);font-weight:600;font-size:12px}
.sw{position:relative;width:44px;height:26px;border-radius:99px;background:#243048;flex:none;transition:background .2s}
.sw::after{content:"";position:absolute;top:3px;inset-inline-start:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform .2s}
.sw[aria-checked=true]{background:var(--v)}
.sw[aria-checked=true]::after{transform:translateX(18px)}
[dir=rtl] .sw[aria-checked=true]::after{transform:translateX(-18px)}
.nav-in{position:relative}
.nav .wrap{position:relative}
header.nav{position:sticky;z-index:100}

/* dev touches */
.idx{position:absolute;top:18px;inset-inline-end:20px;font-family:'Space Grotesk',monospace;font-size:12px;color:var(--muted);opacity:.7;direction:ltr}
.mono{font-family:'Space Grotesk',ui-monospace,monospace;font-size:12px;color:var(--muted);direction:ltr;letter-spacing:.04em}
.mono kbd{font:inherit;border:1px solid var(--line);border-radius:5px;padding:0 6px;color:var(--ink)}
.hue{animation:hue 3s linear 1}
@keyframes hue{to{filter:hue-rotate(360deg)}}

/* profile modal */
#pf{position:fixed;inset:0;z-index:310;background:rgba(3,5,10,.78);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;padding:20px}
#pf.open{display:flex}
.pf-card{width:100%;max-width:400px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(160deg,#142038,#09101c);padding:30px 24px 24px;text-align:center;position:relative;box-shadow:0 40px 100px #000;animation:pfin .35s cubic-bezier(.2,1.2,.4,1)}
@keyframes pfin{from{opacity:0;transform:translateY(20px) scale(.94)}}
.pf-x{position:absolute;top:12px;inset-inline-end:12px;width:36px;height:36px;border-radius:10px;border:1px solid var(--line);font-size:20px;line-height:1}
.pf-img{display:block;width:140px;height:140px;border-radius:24px;object-fit:cover;margin:0 auto 14px;box-shadow:0 0 0 1px rgba(60,200,217,.5),0 0 50px rgba(60,200,217,.45)}
.pf-av{width:84px;height:84px;border-radius:50%;margin:0 auto 14px;display:grid;place-items:center;background:linear-gradient(135deg,var(--v),var(--g));font-family:var(--f-disp);font-size:30px;color:#06231c;box-shadow:0 0 40px rgba(91,141,239,.6)}
.pf-name{font-family:var(--f-disp);font-size:34px;letter-spacing:.04em;line-height:1.1}
.pf-role{color:var(--g);font-weight:800;font-size:14px;margin-top:4px}
.pf-rows{display:grid;gap:10px;margin:22px 0 18px;text-align:start}
.pf-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 14px;border-radius:14px;border:1px solid var(--line);background:var(--glass)}
.pf-row small{display:block;color:var(--muted);font-size:12px}
.pf-row b{font-family:'Space Grotesk',monospace;font-size:15px;direction:ltr;unicode-bidi:plaintext;word-break:break-all}
.pf-row button{flex:none;padding:6px 12px;border-radius:9px;background:var(--v);font-weight:800;font-size:13px}
.pf-row button:active{transform:scale(.94)}

/* reveal */
.rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.8,.2,1);transition-delay:var(--d,0s)}
.rv.in{opacity:1;transform:none}
.no-js .rv{opacity:1;transform:none}
.hero .rv,.stats .rv{opacity:1;transform:none;transition:none}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
  .w-bar i{width:100%}.rv{opacity:1;transform:none}
}

.gal{columns:2;column-gap:14px}
@media(min-width:760px){.gal{columns:3;column-gap:18px}}
.gi{display:block;width:100%;margin:0 0 14px;padding:0;border-radius:18px;overflow:hidden;border:1px solid var(--line);background:#09111e;break-inside:avoid;cursor:zoom-in;position:relative;transition:transform .3s,box-shadow .3s}
@media(min-width:760px){.gi{margin-bottom:18px}}
.gi img{display:block;width:100%;height:auto;transition:transform .6s}
.gi:hover{transform:translateY(-4px);box-shadow:0 24px 60px -24px rgba(91,141,239,.8)}
.gi:hover img{transform:scale(1.05)}
.tracks{display:grid;gap:14px;max-width:760px;margin-inline:auto}
.trk{display:flex;align-items:center;gap:16px;padding:16px 18px;border-radius:20px;border:1px solid var(--line);background:var(--glass);text-align:start;width:100%;color:inherit;transition:border-color .2s,transform .2s,background .2s}
.trk:hover{transform:translateY(-3px);border-color:rgba(91,141,239,.6)}
.trk.on{border-color:var(--g);background:rgba(126,224,195,.06)}
.trk .pl{width:54px;height:54px;border-radius:16px;display:grid;place-items:center;flex:none;background:var(--v);box-shadow:0 12px 30px -10px var(--v)}
.trk.on .pl{background:var(--g);color:#06231c}
.trk .tx{display:grid;gap:2px;min-width:0;flex:1}.trk b{font-size:19px;line-height:1.2}.trk small{color:var(--muted);font-size:14px}
.trk .no{font-family:var(--f-disp);font-size:26px;color:var(--muted);opacity:.6}
.mus{direction:ltr;position:fixed;bottom:22px;inset-inline-end:20px;z-index:95;display:flex;align-items:center;gap:8px;padding:8px 12px 8px 8px;border-radius:18px;background:rgba(10,16,30,.9);backdrop-filter:blur(14px);border:1px solid var(--line);box-shadow:0 14px 40px -10px #000;max-width:calc(100vw - 32px)}
.mus button{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;flex:none;transition:transform .15s;background:var(--glass2)}
.mus button#musBtn{background:var(--v);width:42px;height:42px}
.mus button:hover{transform:scale(1.07)}
.mus .ic{width:1.1em;height:1.1em}
.mus-t{unicode-bidi:plaintext;display:grid;line-height:1.25;min-width:0;max-width:150px}.mus-t b,.mus-t small{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mus-t b{font-size:13px}.mus-t small{font-size:11px;color:var(--muted)}
.mus input[type=range]{width:70px;accent-color:var(--v)}
.mus-eq{display:flex;gap:2px;align-items:flex-end;height:16px;flex:none}.mus-eq i{width:3px;height:4px;background:var(--g);border-radius:2px}
.mus.on .mus-eq i{animation:eqb .9s ease-in-out infinite}.mus.on .mus-eq i:nth-child(2){animation-delay:.2s}.mus.on .mus-eq i:nth-child(3){animation-delay:.4s}
@keyframes eqb{0%,100%{height:4px}50%{height:16px}}
.noanim .mus.on .mus-eq i{animation:none;height:10px}
@media(max-width:560px){.cmdbtn{display:none}.mus{bottom:76px;inset-inline-end:12px;padding:6px;gap:6px}.mus input[type=range],.mus-eq{display:none}.mus-t{max-width:110px}}
.c-dc{cursor:pointer}#livebox,#lv,.fchip.a{display:none!important}
</style>
</head>
